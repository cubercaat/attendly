# ---------- Asosiy ----------
APP_NAME=Attendly
BASE_URL=https://attendly.uz          # HTTPS shart! (localhost istisno)
SECRET_KEY=uzun-tasodifiy-satr-almashtiring
TZ=Asia/Tashkent
TRUST_PROXY=true             # Caddy/Railway ortida true; to'g'ridan-to'g'ri bo'lsa false

# ---------- Baza ----------
DATABASE_URL=postgresql+asyncpg://attendly:parol@postgres:5432/attendly

# ---------- Telegram ----------
BOT_TOKEN=123456:AA...
BOT_USERNAME=AttendlyBot
SUPER_ADMIN_IDS=6616758518

# ---------- QR ----------
QR_ROTATE_SECONDS=3          # QR necha soniyada yangilanadi
QR_ACCEPT_WINDOWS=4          # necha oynaga ruxsat (3s * 4 = 12s TTL)

# ---------- Geofence ----------
DEFAULT_GEOFENCE_RADIUS_M=120
MAX_GPS_ACCURACY_M=100       # bundan yomon aniqlik rad etiladi

# ---------- Yuz tanish ----------
FACE_ENABLED=true
FACE_MATCH_THRESHOLD=0.38    # kosinus masofa: kichikroq = qattiqroq
FACE_MIN_FRAMES=3

# ---------- TEST REJIMI ----------
# true -> /demo sahifasi ochiladi: Telegramsiz, parolsiz kirish.
# Faqat seed_demo.py yaratgan demo hisoblarga kirish mumkin.
# PRODUKSIYADA ALBATTA false QILING.
DEMO_MODE=false

# Quyidagilar default false — ya'ni test rejimida ham GPS va biometrika
# TEKSHIRILADI. Noutbukdan kamera/GPS siz bosib ko'rish uchun yoqing.
DEMO_SKIP_GEOFENCE=false
DEMO_SKIP_BIOMETRY=false
